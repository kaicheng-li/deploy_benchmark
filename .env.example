# ============================================================================
# deploy_benchmark 环境变量配置
# 复制此文件为 .env 并修改
# ============================================================================

# HuggingFace 缓存目录（可选，用于统一模型存储）
HF_HOME=./models/huggingface

# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com

# CUDA 设备
CUDA_VISIBLE_DEVICES=0

# 模型路径
MODEL_QWEN=Qwen/Qwen2-7B-Instruct
MODEL_LLAMA=meta-llama/Meta-Llama-3-8B-Instruct

# 各框架模型缓存
VLLM_MODEL_DIR=./models
TRT_ENGINE_DIR=./tensorrt/trt_engines
ONNX_MODEL_DIR=./onnx/onnx_models
OPENVINO_MODEL_DIR=./openvino/openvino_models
LLAMACPP_GGUF_DIR=./models
