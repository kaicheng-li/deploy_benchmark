# llama.cpp 推理 Docker 镜像
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python binding; no project-local llama.cpp checkout is required.

RUN pip3 install --no-cache-dir "llama-cpp-python>=0.3.34" pyyaml

COPY llamacpp/ /app/llamacpp/
COPY common/ /app/common/

ENTRYPOINT ["python3", "llamacpp/python/inference.py"]
